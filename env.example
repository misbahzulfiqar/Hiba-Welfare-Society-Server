# Copy to .env in this folder (src/server/.env) — never commit .env
#
# Include the database name in the path (hiba-welfare-society):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.net/hiba-welfare-society?retryWrites=true&w=majority&appName=misbah
#
# If your password has special characters, URL-encode them.
# Optional for local Faysal Bank transfer flow: omit this to use in-memory donations (data lost on restart).
# Required for production and for POST /api/payments + /api/health/db.
MONGODB_URI=

PORT=3001

# Sign JWTs for donor login (use a long random string in production)
JWT_SECRET=
# Optional; token lifetime in seconds (default: 604800 = 7 days)
# JWT_EXPIRES_IN=604800

# MongoDB collection names (optional — defaults shown)
# MONGODB_COL_PAYMENT=payment
# MONGODB_COL_DONORS=donors
# MONGODB_COL_CONTACT=contact_messages
# MONGODB_COL_NEWSLETTER=newsletter_subscribers

# Public site URL (no trailing slash)
FRONTEND_URL=https://hiba-welfare-society-web-42eg.vercel.app

# Faysal Bank direct transfer flow does NOT need gateway keys.
# Donors transfer manually to your Faysal Bank account and submit transfer reference.

# Admin login (email + password)
ADMIN_EMAIL=Fayyaz@gmail.com
ADMIN_PASSWORD=admin
ADMIN_SECRET=hiba-admin-dev

# Comma-separated allowed origins (required on Vercel)
CORS_ORIGIN=https://hiba-welfare-society-web-42eg.vercel.app,http://localhost:5173,http://localhost:5174
